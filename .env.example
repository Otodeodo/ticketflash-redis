# Copia este archivo a .env y rellena con los datos de tu base en Redis Cloud.
# Opción A (recomendada): URL completa que muestra Redis Cloud en "Connect".
# Formato: redis://default:<password>@<host>:<port>   (o rediss:// si usa TLS)
REDIS_URL=redis://default:TU_PASSWORD@redis-12345.c123.us-east-1-2.ec2.cloud.redislabs.com:12345

# Opción B: parámetros por separado (se usan solo si REDIS_URL está vacía).
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_SSL=false

# Prefijo (namespace) de todas las claves.
KEY_PREFIX=tf

# Tiempos de expiración en segundos.
SESSION_TTL_SECONDS=1800
HOLD_TTL_SECONDS=600
CACHE_TTL_SECONDS=60

# Tamaño máximo del feed de actividad.
ACTIVITY_MAX=100
