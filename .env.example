# Copia este archivo a .env y rellena los datos de TUS bases. Nunca subas .env a git.

# =========================== PostgreSQL (relacional) ===========================
# Conexión del usuario de la APLICACIÓN (rol tf_app, mínimo privilegio) a Neon/Supabase.
# Neon: panel > Connection Details > pega el host y cambia usuario/clave por los de tf_app.
DATABASE_URL=postgresql://tf_app:TU_PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Solo para administración (crear esquema, seed --reset). NO se despliega en Render.
ADMIN_DATABASE_URL=postgresql://neondb_owner:TU_PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Tamaño del pool de conexiones de la app.
PG_POOL_MIN=1
PG_POOL_MAX=10

# ============================= Redis (no relacional) =============================
# Opción A (recomendada): URL completa que muestra Redis Cloud en "Connect".
# Formato: redis://<usuario>:<password>@<host>:<port>   (o rediss:// si usa TLS)
REDIS_URL=redis://default:TU_PASSWORD@redis-12345.c123.us-east-1-2.ec2.cloud.redislabs.com:12345

# Opción B: parámetros por separado (se usan solo si REDIS_URL está vacía).
REDIS_HOST=
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=
REDIS_SSL=false

# Prefijo (namespace) de todas las claves.
KEY_PREFIX=tf

# Tiempos de expiración en segundos.
SESSION_TTL_SECONDS=1800
HOLD_TTL_SECONDS=600
CACHE_TTL_SECONDS=60

# Tamaño máximo del feed de actividad.
ACTIVITY_MAX=100

# ================================== Seguridad ==================================
# Intentos de login fallidos permitidos y duración del bloqueo (contador en Redis).
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_SECONDS=300

# Contraseña de los usuarios de demostración creados por scripts/seed.py
SEED_PASSWORD=CambiaEstaClaveDeDemo1!

# ================================== Respaldo ===================================
# Usuarios de SOLO LECTURA creados por sql/02_roles_privileges.sql y redis/01_users_acl.redis
BACKUP_DATABASE_URL=postgresql://tf_backup:TU_PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
BACKUP_REDIS_URL=redis://tf_backup:TU_PASSWORD@redis-12345.c123.us-east-1-2.ec2.cloud.redislabs.com:12345
# Carpeta local temporal (puede ser una carpeta sincronizada con Drive/OneDrive).
BACKUP_DIR=backups
# Cuántos respaldos conservar (retención).
BACKUP_KEEP=14
# Destino remoto (opcional). Elige UNO:
#   S3 / Cloudflare R2 / Backblaze B2 (requiere boto3):
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=ticketflash/
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
#   rclone (Google Drive, OneDrive, SFTP...): nombre del remote y carpeta, p. ej. gdrive:ticketflash-backups
BACKUP_RCLONE_REMOTE=
